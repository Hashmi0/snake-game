{
  "name": "snake-garden",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config playwright.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:test": "vite build --mode e2e --outDir dist-test",
    "preview": "vite preview --host 0.0.0.0",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:performance": "node scripts/performance.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/three": "0.185.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
